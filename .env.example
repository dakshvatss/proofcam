# Meta Model API key (https://dev.meta.ai). Never commit a real key.
MODEL_API_KEY=

# Optional overrides
PROOFCAM_MUSE_MODEL=muse-spark-1.3
PROOFCAM_SAM_MODEL=sam-3.1
PROOFCAM_API_BASE=https://api.meta.ai/v1
# minimal | low | medium | high | xhigh | max  (unset = API default)
PROOFCAM_MUSE_REASONING_EFFORT=

# Access code for any device other than this computer (>= 12 chars; e.g. python -c "import secrets;print(secrets.token_urlsafe(18))").
# Unset = the API only answers requests made directly on this computer.
PROOFCAM_ACCESS_CODE=
# Hard cap on paid model calls across ALL inspections in the database (default 50; "none" disables).
PROOFCAM_GLOBAL_CALL_LIMIT=
